{
  "name": "liquid-glass-kit",
  "version": "1.0.0",
  "description": "Seven-layer liquid glass material with fixed-anchor pull physics and opt-in fusion.",
  "license": "MIT",
  "homepage": "https://github.com/cao123-2024/liquid-glass-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cao123-2024/liquid-glass-kit.git"
  },
  "bugs": {
    "url": "https://github.com/cao123-2024/liquid-glass-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/liquid-glass-kit.umd.cjs",
  "module": "./dist/liquid-glass-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/liquid-glass-kit.js",
      "require": "./dist/liquid-glass-kit.umd.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/liquid-glass-kit.css"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config vite.lib.config.ts && vite build --config vite.react.config.ts && vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
